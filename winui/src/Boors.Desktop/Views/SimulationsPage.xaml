<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Boors.Desktop.Views.SimulationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Boors.Desktop.Infrastructure"
    xmlns:vm="using:Boors.Desktop.ViewModels"
    xmlns:controls="using:Boors.Desktop.Controls"
    xmlns:charts="using:Boors.Desktop.Charts"
    Background="Transparent">

    <Grid Padding="24,12,24,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="300" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title, progress, new simulation, reload -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{l:L K='Simulations'}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsReplaying, Mode=OneWay}" Width="18" Height="18" HorizontalAlignment="Left" />
            <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="OnNew" AutomationProperties.Name="{l:L K='New simulation'}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="{l:L K='New simulation'}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Click="OnReload" AutomationProperties.Name="{l:L K='Replay all'}" ToolTipService.ToolTip="{l:L K='Replay every simulation with the latest data (F5)'}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="{l:L K='Replay all'}" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="WrapWholeWords"
                       Text="{l:L K='Each simulation is a paper portfolio replayed session by session from its start date and followed every day as new sessions arrive. Orders are decided at a close and fill on the next session, never in a buy queue (to buy) or a sell queue (to sell), with the real costs and T+2 settlement.'}" />
            <InfoBar Severity="Error" IsClosable="True" Title="{l:L K='Could not replay the simulations'}"
                     IsOpen="{x:Bind l:Bools.HasText(ViewModel.Error), Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
        </StackPanel>

        <!-- Empty state: the ways to begin -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="24" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <StackPanel Spacing="12">
                <TextBlock Text="{l:L K='No simulations yet'}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="WrapWholeWords"
                           Text="{l:L K='Start one today and follow it with the market, or start it in the past to see how a strategy would have done up to today — it then keeps following the market from here. In automatic mode the strategy picks, sizes and sells; in manual mode you place the orders and the strategy only suggests.'}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource AccentButtonStyle}" Content="{l:L K='New simulation'}" Click="OnNew" />
                    <Button Content="{l:L K='Try the adaptive strategy from a year ago'}" Click="OnQuickAdaptive" />
                    <Button Content="{l:L K='A manual portfolio from today'}" Click="OnQuickManual" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ItemsRepeater Grid.Row="3" ItemsSource="{x:Bind ViewModel.Kpis, Mode=OneWay}">
            <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="208" MinItemHeight="104" MinColumnSpacing="10" MinRowSpacing="10" ItemsStretch="Fill" MaximumRowsOrColumns="6" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:KpiItem">
                    <controls:KpiTile Item="{x:Bind}" />
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <!-- As tall as its rows, up to a dozen; the comparison takes the rest of the page -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0" MaxHeight="420" Visibility="{x:Bind ViewModel.HasData, Mode=OneWay}">
            <controls:DataTable x:Name="Table" FrozenColumns="1" Items="{x:Bind ViewModel.Rows, Mode=OneWay}" />
        </Border>

        <!-- Comparison: up to six equity curves, each indexed to 100 at its own start, with TEDPIX -->
        <Grid Grid.Row="5" ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasData, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{l:L K='Compared: each indexed to 100 at its start, with TEDPIX from the earliest start'}" Style="{StaticResource SectionTitleStyle}" TextTrimming="CharacterEllipsis" />
                    <charts:ComparisonChart x:Name="CompareChart" Grid.Row="1" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{l:L K='Show in the comparison (up to six)'}" Style="{StaticResource SectionTitleStyle}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.CompareItems, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:CompareItem">
                                    <Grid ColumnSpacing="8" Padding="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=OneWay}" MinWidth="0" Click="OnCompareClick" Tag="{x:Bind}"
                                                  AutomationProperties.Name="{x:Bind Name}" />
                                        <Rectangle Grid.Column="1" Width="14" Height="3" RadiusX="1" RadiusY="1" Fill="{x:Bind SwatchBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind ReturnText}" VerticalAlignment="Center" Style="{StaticResource NumberTextStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="6" Style="{StaticResource MutedTextStyle}" TextWrapping="WrapWholeWords"
                   Text="{l:L K='Simulations are paper trading for research and practice, not buy or sell advice. A replay uses only data known at each close, but over the instruments listed today (delisted companies are missing), and a past that worked is no promise: prefer strategies that also held up out of sample.'}" />
    </Grid>
</Page>
